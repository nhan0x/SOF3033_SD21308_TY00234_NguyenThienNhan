e="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="400" as="sourcePoint"/><mxPoint x="320" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="② JDBC: câu lệnh SQL&lt;br&gt;(TCP 1433)" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;startArrow=none;endFill=1;strokeWidth=2;strokeColor=#036897;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="215" as="sourcePoint"/><mxPoint x="960" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="③ ResultSet&lt;br&gt;(kết quả truy vấn)" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;startArrow=none;endFill=1;strokeWidth=2;strokeColor=#036897;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="400" as="sourcePoint"/><mxPoint x="810" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Luồng giao tiếp:&lt;/b&gt; ① Trình duyệt gửi HTTP Request → Tomcat (Filter kiểm tra UTF-8, đăng nhập, quyền) → Servlet đọc &amp; kiểm tra tham số → ② DAO gửi SQL qua JDBC tới SQL Server → ③ SQL Server trả ResultSet → Servlet đưa dữ liệu vào request, forward JSP → ④ Tomcat gửi HTTP Response (HTML) về trình duyệt." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=note;size=14;strokeColor=#4D4D4D;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1200" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Luu do Request-Response" id="p11431"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1200" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;