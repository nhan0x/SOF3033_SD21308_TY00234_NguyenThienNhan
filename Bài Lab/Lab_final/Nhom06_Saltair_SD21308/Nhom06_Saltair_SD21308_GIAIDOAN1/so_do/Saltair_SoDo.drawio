="330" width="380" height="28" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;SMTP Gmail&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;gửi mail báo đăng nhập&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#036897;fillColor=#F5FAFD;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="370" width="380" height="62" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="300" as="sourcePoint"/><mxPoint x="980" y="401" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Cloudinary&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;lưu ảnh upload&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#036897;fillColor=#F5FAFD;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="450" width="380" height="62" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="340" as="sourcePoint"/><mxPoint x="980" y="481" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;payOS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;thanh toán chuyển khoản + webhook&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#036897;fillColor=#F5FAFD;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="530" width="380" height="62" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="380" as="sourcePoint"/><mxPoint x="980" y="561" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Luồng:&lt;/b&gt; Trình duyệt gửi HTTP Request → Tomcat → Filter (mã hóa UTF-8, kiểm tra đăng nhập, kiểm tra quyền Admin) → Servlet (Controller) → Service (nghiệp vụ + transaction) → DAO (PreparedStatement) → MySQL; kết quả trả lại Servlet, forward sang JSP (View) và HTTP Response về trình duyệt. Service gọi thêm SMTP Gmail, Cloudinary, payOS khi cần; payOS gọi ngược lại PaymentWebhookServlet khi tiền về." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=note;size=14;strokeColor=#4D4D4D;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1320" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Kien truc phan tang MVC" id="p49471"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;KIẾN TRÚC PHÂN TẦNG&lt;/b&gt; – MVC + Service + DAO (Servlet → Service → DAO → MySQL)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1320" height="34" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Trình duyệt&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Khách / Admin&lt;br&gt;HTML · CSS · JS&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;strokeColor=#555555;strokeWidth=2;fillColor=#EDEDED;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="190" height="210" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Filter&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;EncodingFilter&lt;br&gt;AuthFilter · AdminFilter&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;strokeColor=#B26B00;strokeWidth=2;fillColor=#FFF4DE;fontSize=15;" vertex="1" parent="1"><mxGeometry x="265" y="120" width="190" height="210" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Servlet theo chức năng:&lt;br&gt;auth · account · shop&lt;br&gt;cart · order · admin&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;strokeColor=#036897;strokeWidth=2;fillColor=#DCEBFA;fontSize=15;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="190" height="210" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Nghiệp vụ + transaction:&lt;br&gt;AuthService, CartService&lt;br&gt;OrderService, VoucherService&lt;br&gt;PaymentService, ...&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;strokeColor=#036897;strokeWidth=2;fillColor=#DCEBFA;fontSize=15;" vertex="1" parent="1"><mxGeometry x="715" y="120" width="190" height="210" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;DAO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Toàn bộ SQL&lt;br&gt;(PreparedStatement):&lt;br&gt;UserDAO, ProductDAO&lt;br&gt;OrderDAO, VoucherDAO...&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;strokeColor=#036897;strokeWidth=2;fillColor=#DCEBFA;fontSize=15;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="190" height="210" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;MySQL 8&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;18 bảng&lt;br&gt;InnoDB, utf8mb4&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;strokeColor=#2E7D32;strokeWidth=2;fillColor=#E3F4E6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1165" y="120" width="190" height="210" as="geometry"/></mxCell><mxCell id="c9" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;View (JSP + JSTL + tag)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;/WEB-INF/views/…&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;strokeColor=#7B1FA2;strokeWidth=2;fillColor=#F3E5F5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="515" y="420" width="190" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Model / DTO&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;16 lớp ánh xạ bảng, constant, exception&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=8;strokeColor=#7B1FA2;strokeWidth=2;fillColor=#F3E5F5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="965" y="420" width="250" height="90" as="geometry"/></mxCell><mxCell id="c16" value="forward" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="c6" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="html=1;fontFamily=Helvetica;strokeColor=#4D4D4D;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="c7" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Util dùng chung:&lt;/b&gt; DBContext · PasswordUtil · MailUtil · ImageUploadUtil · CloudinaryUtil · PayOSSignature · QrSvg · SlugUtil · Page · DBMigration" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;strokeColor=#888;fillColor=#FAFAFA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1175" height="60" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Quy tắc luồng gọi:&lt;/b&gt; Servlet không gọi thẳng DAO và không viết SQL · DAO chỉ chứa SQL, không chứa nghiệp vụ · JSP chỉ hiển thị, không gọi DAO/Service · Mỗi chức năng nằm trong thư mục cùng tên ở cả ba tầng." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=note;size=14;strokeColor=#4D4D4D;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1175" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="ERD Saltair" id="p38617"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1320" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;SƠ ĐỒ QUAN HỆ THỰC THỂ (ERD)&lt;/b&gt; – CSDL Saltair (MySQL 8, 18 bảng)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#222222;strokeWidth=1.2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="270" height="179" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;users&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#222222;strokeWidth=1.2;fillColor=#D9D9D9;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="270" height="26" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;PK&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="42" y="329" width="34" height="21" as="geometry"/></mxCell><mxCell id="c6" value="&lt;u&gt;&lt;b&gt;id : INT&lt;/b&gt;&lt;/u&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontS