<%-- Cần: filterAction, from, to --%>
<form method="get" action="${filterAction}" class="search">
  <label>Từ ngày
    <input type="date" name="from" value="<c:out value='${from}'/>" required>
  </label>
  <label>Đến ngày
    <input type="date" name="to" value="<c:out value='${to}'/>" required>
  </label>
  <button type="submit" class="primary">Xem</button>
</form>
<c:if test="${not empty error}"><div class="msg err" role="alert"><c:out value="${error}"/></div></c:if>
