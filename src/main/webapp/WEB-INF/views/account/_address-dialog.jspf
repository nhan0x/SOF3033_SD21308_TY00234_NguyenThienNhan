<%--
  Hộp thoại thêm / sửa địa chỉ, dùng chung cho addresses.jsp và profile.jsp (điền sẵn bằng data-fill).
  Trang gọi phải khai báo taglib c, fn, t và đặt trước khi include: <c:set var="addressDialogOpen" value="true|false"/>
  (true = tự mở lại hộp thoại vì form vừa gửi có lỗi). Form: POST /addresses action=save, xong thì về /addresses.
--%>
<%-- Chỉ hiện lỗi của form địa chỉ: ở profile.jsp, errors là lỗi của form thông tin cá nhân (cũng có khóa phone) --%>
<c:set var="addrErrors" value="${addressDialogOpen ? errors : null}"/>
<dialog class="dialog" id="address-dialog" aria-labelledby="address-dialog-title"${addressDialogOpen ? ' data-open' : ''}>
  <form method="post" action="${ctx}/addresses">
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="id" value="${empty param.id ? 0 : fn:escapeXml(param.id)}">
    <div class="dialog__head">
      <h2 class="h-2" id="address-dialog-title" data-dialog-title>${empty param.id or param.id == '0' ? 'Thêm địa chỉ mới' : 'Sửa địa chỉ'}</h2>
      <button type="button" class="icon-btn" data-dialog-close aria-label="Đóng"><t:icon name="x" size="md"/></button>
    </div>
    <div class="dialog__body">
      <div class="form-grid">
        <div class="field">
          <label class="field__label" for="addr-receiver">Người nhận</label>
          <input class="input${not empty addrErrors.receiverName ? ' is-invalid' : ''}" id="addr-receiver" type="text" name="receiverName"
                 value="${fn:escapeXml(param.receiverName)}" autocomplete="name" maxlength="100" required>
          <c:if test="${not empty addrErrors.receiverName}"><span class="field__error"><c:out value="${addrErrors.receiverName}"/></span></c:if>
        </div>
        <div class="field">
          <label class="field__label" for="addr-phone">Số điện thoại</label>
          <input class="input${not empty addrErrors.phone ? ' is-invalid' : ''}" id="addr-phone" type="tel" name="phone"
                 value="${fn:escapeXml(param.phone)}" autocomplete="tel" inputmode="numeric" pattern="0[0-9]{9}" title="Số điện thoại gồm 10 chữ số, bắt đầu bằng 0" required>
          <c:if test="${not empty addrErrors.phone}"><span class="field__error"><c:out value="${addrErrors.phone}"/></span></c:if>
        </div>
        <div class="field span-2">
          <label class="field__label" for="addr-line">Số nhà, tên đường</label>
          <input class="input${not empty addrErrors.addressLine ? ' is-invalid' : ''}" id="addr-line" type="text" name="addressLine"
                 value="${fn:escapeXml(param.addressLine)}" autocomplete="address-line1" maxlength="255" required>
          <c:if test="${not empty addrErrors.addressLine}"><span class="field__error"><c:out value="${addrErrors.addressLine}"/></span></c:if>
        </div>
        <div class="field">
          <label class="field__label" for="addr-ward">Phường, xã</label>
          <input class="input${not empty addrErrors.ward ? ' is-invalid' : ''}" id="addr-ward" type="text" name="ward"
                 value="${fn:escapeXml(param.ward)}" maxlength="100">
          <c:if test="${not empty addrErrors.ward}"><span class="field__error"><c:out value="${addrErrors.ward}"/></span></c:if>
        </div>
        <div class="field">
          <label class="field__label" for="addr-district">Quận, huyện</label>
          <input class="input${not empty addrErrors.district ? ' is-invalid' : ''}" id="addr-district" type="text" name="district"
                 value="${fn:escapeXml(param.district)}" maxlength="100">
          <c:if test="${not empty addrErrors.district}"><span class="field__error"><c:out value="${addrErrors.district}"/></span></c:if>
        </div>
        <div class="field span-2">
          <label class="field__label" for="addr-city">Tỉnh, thành phố</label>
          <input class="input${not empty addrErrors.city ? ' is-invalid' : ''}" id="addr-city" type="text" name="city"
                 value="${fn:escapeXml(param.city)}" autocomplete="address-level1" maxlength="100" required>
          <c:if test="${not empty addrErrors.city}"><span class="field__error"><c:out value="${addrErrors.city}"/></span></c:if>
        </div>
      </div>
      <label class="checkbox">
        <input type="checkbox" name="defaultAddress" value="true"${param.defaultAddress == 'true' ? ' checked' : ''}>
        <span>Đặt làm địa chỉ mặc định</span>
      </label>
    </div>
    <div class="dialog__foot">
      <button type="button" class="btn btn--ghost" data-dialog-close>Hủy</button>
      <button type="submit" class="btn btn--primary">Lưu địa chỉ</button>
    </div>
  </form>
</dialog>
